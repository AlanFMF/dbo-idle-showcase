# Aplicação
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dbo_idle_demo
DB_USER=dbo_idle_demo
DB_PASSWORD=replace-with-a-local-password
DB_POOL_MAX=10

# E-mail de desenvolvimento
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-a-test-user
SMTP_PASSWORD=replace-with-a-test-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=DBO IDLE Demo

# Pagamentos — use somente credenciais de teste
MERCADOPAGO_MODE=test
MERCADOPAGO_PUBLIC_KEY=replace-with-a-test-public-key
MERCADOPAGO_ACCESS_TOKEN=replace-with-a-test-access-token
MERCADOPAGO_WEBHOOK_SECRET=replace-with-a-test-webhook-secret
MERCADOPAGO_VERIFY_WEBHOOK_SIGNATURE=true
PAYMENTS_MAX_INSTALLMENTS=1
PIX_EXPIRATION_MINUTES=30

# Configurações privadas fora do repositório
DBO_IDLE_CONFIG_DIR=./private-config
